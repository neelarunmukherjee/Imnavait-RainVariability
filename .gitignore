# Full ATS output copies (originals live in v5_1/run/); only the slim
# runNN_* directories are part of the data package
runs/transect_imnavait_rainsigma_ensemble_*/

# Within run directories keep only final checkpoints, observations and the
# trimmed Figure 3/4 visualization subsets
runs/**/checkpoint[0-9]*.h5
runs/**/*.xmf
runs/**/*.log
runs/**/*.err

# Working copies used to assemble the package
inputs_raw/
data_raw/
scripts_raw/
inputs/.claude/

# Figures regenerated by scripts/ICVar_Figures.ipynb
scripts/figures

# Python cache
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# OS/editor artifacts
.DS_Store
*.swp
*.swo
